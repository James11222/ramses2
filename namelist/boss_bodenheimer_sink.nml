This is the RAMSES parameter file for Boss and Bodenheimer (1979) collapse test
with sink formation and Bondi accretion.
Compile the code with:

make NDIM=3 MPI=1 GRAV=1 HYDRO=1 MHD=1 INIT=COLLAPSE

&RUN_PARAMS
cosmo=.false.
hydro=.true.
poisson=.true.
pic=.true.
nrestart=0
nsubcycle=5*1,2
verbose=.false.
/

&AMR_PARAMS
levelmin=5
levelmax=14 ! ~ 0.24 AU
ngridmax=2000000
ncachemax=1000000
nexpand=30*2
boxlen=0.191405298315250E-01 ! ~ 4000 AU
/

&INIT_PARAMS
/

&OUTPUT_PARAMS
tout=9.10e-5,9.11e-5,9.12e-5,9.13e-5,9.14e-5,9.15e-5,9.16e-5,9.17e-5,9.18e-5,9.19e-5,9.20e-5
/

&POISSON_PARAMS
gravity_type=0
epsilon=1.d-4
/

&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.6
slope_type=1
riemann='llf'
riemann2d='llf'
/

&UNITS_PARAMS
units_density=0.383460000000000E-23
units_time=0.197732040946880E+16
units_length=3.0857d18
/

&COOLING_PARAMS
isothermal=.true.
eos_type=5
eos_T2=4.29
/

&REFINE_PARAMS
jeans_refine=30*8.
sink_refine=.true.
interpol_var=0
interpol_type=1
/

&SINK_PARAMS
sink=.true.
nsinkmax=1000
rho_type_sink=4
sink_form=.true.
sink_density_threshold=2e14
sink_relevance_threshold=3
sink_mass_threshold=0.2
sink_recenter_on_peak=.false.
sink_mseed=1e-5
verbose_sink=.false.
/

&SINK_ACCRETION_PARAMS
accretion_type=3
momentum_conserving=.true.
/
