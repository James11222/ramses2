!> GPU sink particle evolution CUDA kernels (accretion, drag, AGN feedback).
module sink_device
  use amr_parameters, only: ndim, twotondim, dp, i8b
  use hydro_parameters, only: nvar, nener
  use oct_commons, only: oct
  use gpu_utils
  use cudafor
  use feedback_device, only: get_cell_by_key
  use gpu_runner, only: grid, uold, unew, bold, rho, &
       & sink_xp, sink_vp, sink_mp, sink_tp, sink_jp
  implicit none

  ! Krumholz et al. 2004 table of alpha = rho/rho_inf for x = r/r_Bondi in [0.01,2]
  real(kind=dp), parameter, dimension(51) :: alphatable_const = (/ &
       820.254_dp, 701.882_dp, 600.752_dp, 514.341_dp, 440.497_dp, 377.381_dp, 323.427_dp, &
       277.295_dp, 237.845_dp, 204.1_dp, 175.23_dp, 150.524_dp, 129.377_dp, 111.27_dp, 95.7613_dp, &
       82.4745_dp, 71.0869_dp, 61.3237_dp, 52.9498_dp, 45.7644_dp, 39.5963_dp, 34.2989_dp, &
       29.7471_dp, 25.8338_dp, 22.4676_dp, 19.5705_dp, 17.0755_dp, 14.9254_dp, 13.0714_dp, &
       11.4717_dp, 10.0903_dp, 8.89675_dp, 7.86467_dp, 6.97159_dp, 6.19825_dp, 5.52812_dp, &
       4.94699_dp, 4.44279_dp, 4.00497_dp, 3.6246_dp, 3.29395_dp, 3.00637_dp, 2.75612_dp, &
       2.53827_dp, 2.34854_dp, 2.18322_dp, 2.03912_dp, 1.91344_dp, 1.80378_dp, 1.70804_dp, &
       1.62439_dp /)

contains

  include 'gpu_reduce.cuf'

  !> B-spline cell key and weight of the j-th stencil cell (j=0..order**3-1)
  !> for a sink at position x (in units of dx at level ilevel).
  !> Mirrors sink_B_spline_weights_CIC/TSC/PCS, including periodic wrap.
  attributes(device) subroutine sink_bspline_device(order, x, j, &
       & box_ckey_min_d, box_ckey_max_d, periodic_d, ilevel, ckey, xnei, w)
    implicit none
    integer(kind=4), intent(in), value :: order
    real(kind=dp), intent(in) :: x(3)
    integer(kind=4), intent(in), value :: j
    integer(kind=4), device :: box_ckey_min_d(3,*)
    integer(kind=4), device :: box_ckey_max_d(3,*)
    logical, device :: periodic_d(3)
    integer(kind=4), intent(in), value :: ilevel
    integer(kind=4), intent(out) :: ckey(3)
    real(kind=dp), intent(out) :: xnei(3)
    real(kind=dp), intent(out) :: w

    integer :: idim, k, jj, ibase
    real(kind=dp) :: dr, xc, wd

    w = 1.0_dp
    jj = j
    do idim = 1, 3
       k = mod(jj, order)
       jj = jj / order
       if (order == 2) then
          ! CIC (dr: right cloud boundary)
          dr = x(idim) + 0.5_dp
          ibase = floor(dr) - 1
          dr = dr - real(ibase + 1, kind=dp)
          if (k == 0) then
             wd = 1.0_dp - dr
          else
             wd = dr
          endif
       else if (order == 3) then
          ! TSC
          ibase = int(x(idim)) - 1
          xc = real(ibase + k, kind=dp) + 0.5_dp
          if (k == 1) then
             wd = 0.75_dp - (x(idim) - xc)**2
          else
             wd = 0.5_dp * (1.5_dp - abs(x(idim) - xc))**2
          endif
       else
          ! PCS
          ibase = int(x(idim) + 1.5_dp) - 3
          xc = real(ibase + k, kind=dp) + 0.5_dp
          if (k == 0 .or. k == 3) then
             wd = (2.0_dp - abs(x(idim) - xc))**3 / 6.0_dp
          else
             wd = (4.0_dp - 6.0_dp*(x(idim) - xc)**2 + 3.0_dp*abs(x(idim) - xc)**3) / 6.0_dp
          endif
       endif
       w = w * wd
       ckey(idim) = ibase + k
       xnei(idim) = real(ibase + k, kind=dp) + 0.5_dp
       ! Periodic boundary conditions
       if (periodic_d(idim)) then
          if (ckey(idim) <  box_ckey_min_d(idim, ilevel + 1)) &
               & ckey(idim) = ckey(idim) - box_ckey_min_d(idim, ilevel + 1) + box_ckey_max_d(idim, ilevel + 1)
          if (ckey(idim) >= box_ckey_max_d(idim, ilevel + 1)) &
               & ckey(idim) = ckey(idim) + box_ckey_min_d(idim, ilevel + 1) - box_ckey_max_d(idim, ilevel + 1)
       endif
    end do
  end subroutine sink_bspline_device

  !> alpha = rho/rho_inf for a critical Bondi solution at x = r/r_Bondi
  !> (Krumholz et al. 2004), mirrors bondi_alpha in sink_evolution.f90
  attributes(device) function bondi_alpha_device(x) result(alpha)
    implicit none
    real(kind=dp), intent(in), value :: x
    real(kind=dp) :: alpha

    real(kind=dp), parameter :: xmin = 0.01_dp, xmax = 2.0_dp
    integer, parameter :: ntable = 51
    real(kind=dp) :: lambda_c, xtable, xtablep1, alpha_exp
    integer :: idx

    lambda_c = exp(1.5_dp) / 4.0_dp
    if (x <= xmin) then
       alpha = lambda_c / sqrt(2.0_dp * x**3)
    else if (x >= xmax) then
       alpha = exp(1.0_dp / x)
    else
       idx = floor((ntable - 1) * log(x / xmin) / log(xmax / xmin))
       xtable   = exp(log(xmin) + real(idx, kind=dp)     * log(xmax / xmin) / real(ntable - 1, kind=dp))
       xtablep1 = exp(log(xmin) + real(idx + 1, kind=dp) * log(xmax / xmin) / real(ntable - 1, kind=dp))
       alpha_exp = log(x / xtable) / log(xtablep1 / xtable)
       alpha = alphatable_const(idx + 1) * (alphatable_const(idx + 2) / alphatable_const(idx + 1))**alpha_exp
    endif
  end function bondi_alpha_device

  !> AGN feedback radial weight, mirrors psy_function (constant for now)
  attributes(device) function psy_function_device(quasar_mode, r) result(psy)
    implicit none
    logical, intent(in), value :: quasar_mode
    real(kind=dp), intent(in), value :: r
    real(kind=dp) :: psy

    psy = 1.0_dp
  end function psy_function_device

  !> Sink evolution: one block per sink of level ilevel. Mirrors the loop
  !> body of sink_evolution in sink_evolution.f90: [A] accretion (one thread
  !> per B-spline cell), [B] dynamical friction, [C] AGN feedback, [D] periodic wrap.
  attributes(global) subroutine sink_evolution_kernel( &
       & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, ngridmax, &
       & box_ckey_min_d, box_ckey_max_d, periodic_d, &
       & head_idx, ilevel, order, nBHnei, accretion_type, &
       & skip1, skip2, skip3, dx_loc, vol_loc, dtnew, t, &
       & factG, lambda_sonic, edd_fac, eddington_cap, eddington_floor, &
       & t_start_black_hole, manual_accretion_rate, sink_density_threshold, &
       & gamma, smallr, smallc, boost_fac, &
       & use_local_bondi_rate, bondi_use_vrel, bondi_use_gas_mass, use_rho_inf, &
       & mass_weighting, momentum_conserving, fix_sink_mass, static, &
       & bs1, bs2, bs3, macc_loc_d)
    implicit none
    integer(kind=8), device :: hash_key_d(*)
    integer(kind=4), device :: hash_val_d(*)
    integer(kind=4), intent(in), value :: hash_size_d
    integer(kind=4), device :: ckey_max_d(*)
    integer(kind=8), device :: key_off_d(*)
    integer(kind=4), intent(in), value :: ngridmax
    integer(kind=4), device :: box_ckey_min_d(3,*)
    integer(kind=4), device :: box_ckey_max_d(3,*)
    logical, device :: periodic_d(3)
    integer(kind=4), intent(in), value :: head_idx, ilevel, order, nBHnei, accretion_type
    real(kind=dp), intent(in), value :: skip1, skip2, skip3, dx_loc, vol_loc, dtnew, t
    real(kind=dp), intent(in), value :: factG, lambda_sonic, edd_fac, eddington_cap, eddington_floor
    real(kind=dp), intent(in), value :: t_start_black_hole, manual_accretion_rate, sink_density_threshold
    real(kind=dp), intent(in), value :: gamma, smallr, smallc, boost_fac
    logical, intent(in), value :: use_local_bondi_rate, bondi_use_vrel, bondi_use_gas_mass, use_rho_inf
    logical, intent(in), value :: mass_weighting, momentum_conserving, fix_sink_mass, static
    real(kind=dp), intent(in), value :: bs1, bs2, bs3
    real(kind=dp), device :: macc_loc_d

    real(kind=dp), parameter :: pi = 3.14159265358979_dp
    real(kind=dp), shared :: s_dMBH, s_rho_gas
    logical, shared :: s_skip
    integer :: ipart, j, idim, igrid, icell, igridn, icelln, info
#if NVAR>5+NENER
    integer :: ivar
#endif
#if NENER>0
    integer :: irad
#endif
    integer(kind=4) :: ckey(3), ckey_div(3)
    logical :: found
    real(kind=dp) :: xcen(3), xnei(3), x_rel(3), vv(3), v_rel(3), vp(3)
    real(kind=dp) :: w, d, e, ethermal, cs, mp, mtot
    real(kind=dp) :: rho_gas, cs_gas, m_gas, rho_av_all, weighted_bondi, total_divergence
    real(kind=dp) :: vel_gas(3)
    real(kind=dp) :: div_right, div_left, v_bondi, bondi_mass, rb, rb_max, r_rel
    real(kind=dp) :: rho_inf, dMBH, dMED
    real(kind=dp) :: d_acc, m_acc, x_acc(3), p_acc(3), l_acc(3)
#ifdef MHD
    real(kind=dp) :: bx, by, bz
#endif

    ipart = head_idx + blockIdx%x - 1
    j = threadIdx%x - 1

    ! Skip zero-mass (merged/defunct) sinks (the whole block exits)
    if (sink_mp(ipart) <= 0.0_dp) return

    mp = sink_mp(ipart)
    vp(1) = sink_vp(ipart, 1)
    vp(2) = sink_vp(ipart, 2)
    vp(3) = sink_vp(ipart, 3)
    xcen(1) = (sink_xp(ipart, 1) + skip1) / dx_loc
    xcen(2) = (sink_xp(ipart, 2) + skip2) / dx_loc
    xcen(3) = (sink_xp(ipart, 3) + skip3) / dx_loc

    ! Largest Bondi radius whose square times a density cannot overflow
    rb_max = sqrt(sqrt(huge(1.0_dp)))

    ! Accretion outputs, also read by friction and AGN feedback
    ! (zero when accretion is disabled, as on the CPU)
    rho_gas = 0.0_dp; vel_gas = 0.0_dp; cs_gas = 0.0_dp; m_gas = 0.0_dp
    rho_av_all = 0.0_dp; weighted_bondi = 0.0_dp; total_divergence = 0.0_dp
    rho_inf = 0.0_dp; dMBH = 0.0_dp; dMED = 0.0_dp

    !===========================================
    ! [A] Sink accretion
    !===========================================
    if (accretion_type > 0) then

    !-------------------------------------------
    ! Gather: collect local gas information
    !-------------------------------------------

    found = .false.
    if (j < nBHnei) then
       call sink_bspline_device(order, xcen, j, box_ckey_min_d, box_ckey_max_d, periodic_d, &
            & ilevel, ckey, xnei, w)
       call get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
            & ilevel, ckey, igrid, icell)
       found = (igrid > 0 .and. igrid <= ngridmax)
    endif

    if (found) then
       x_rel(1:3) = xnei(1:3) - xcen(1:3)
       d     = max(uold(icell, 1, igrid), smallr)
       vv(1) = uold(icell, 2, igrid) / d
       vv(2) = uold(icell, 3, igrid) / d
       vv(3) = uold(icell, 4, igrid) / d
       e     = uold(icell, 5, igrid)
       ! Remove all non-thermal energies as they are not accreted
#ifdef MHD
       bx = 0.5_dp * (bold(icell, 1, igrid) + bold(icell, 4, igrid))
       by = 0.5_dp * (bold(icell, 2, igrid) + bold(icell, 5, igrid))
       bz = 0.5_dp * (bold(icell, 3, igrid) + bold(icell, 6, igrid))
       e = e - 0.5_dp * (bx**2 + by**2 + bz**2)
#endif
#if NENER>0
       do irad = 1, nener
          e = e - uold(icell, 5 + irad, igrid)
       end do
#endif
       ethermal = (e - 0.5_dp * d * (vv(1)**2 + vv(2)**2 + vv(3)**2)) / d
       cs = sqrt(max(gamma * (gamma - 1.0_dp) * ethermal, smallc**2) * boost_fac)

       ! Add to average (weighted) information
       rho_gas      = d * w
       vel_gas(1:3) = vv(1:3) * w
       cs_gas       = cs * w
       m_gas        = d * w * vol_loc
#ifdef GRAV
       rho_av_all   = rho(icell, igrid) * w
#endif
       ! Local mass divergence for Bleuler+14 flux accretion
       if (accretion_type == 2) then
          do idim = 1, 3
             ckey_div(1:3) = ckey(1:3)
             ckey_div(idim) = ckey_div(idim) + 1
             call get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
                  & ilevel, ckey_div, igridn, icelln)
             if (igridn <= 0 .or. igridn > ngridmax) cycle
             div_right = (uold(icelln, 1 + idim, igridn) &
                  & - max(uold(icelln, 1, igridn), smallr) * vp(idim)) / dx_loc
             ckey_div(1:3) = ckey(1:3)
             ckey_div(idim) = ckey_div(idim) - 1
             call get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
                  & ilevel, ckey_div, igridn, icelln)
             if (igridn <= 0 .or. igridn > ngridmax) cycle
             div_left = (uold(icelln, 1 + idim, igridn) &
                  & - max(uold(icelln, 1, igridn), smallr) * vp(idim)) / dx_loc
             total_divergence = total_divergence + (div_right - div_left) / 2.0_dp
          end do
       endif

       ! Local Bondi rate
       if (use_local_bondi_rate) then
          v_rel(1:3) = vv(1:3) - vp(1:3)
          if (bondi_use_vrel) then
             v_bondi = sqrt(v_rel(1)**2 + v_rel(2)**2 + v_rel(3)**2 + cs**2)
          else
             v_bondi = cs
          endif
          if (bondi_use_gas_mass) then
             bondi_mass = mp + d * vol_loc
          else
             bondi_mass = mp
          endif
          rb = min(factG * bondi_mass / v_bondi**2, rb_max)
          if (use_rho_inf) then
             r_rel = sqrt(x_rel(1)**2 + x_rel(2)**2 + x_rel(3)**2) * dx_loc
             rho_inf = d / bondi_alpha_device(r_rel / (rb + tiny(1.0_dp)))
          else
             rho_inf = d
          endif
          weighted_bondi = 4.0_dp * pi * rho_inf * rb * rb * v_bondi * lambda_sonic * w
       endif
    endif

    rho_gas          = block_reduce_dp_sum(rho_gas)
    vel_gas(1)       = block_reduce_dp_sum(vel_gas(1))
    vel_gas(2)       = block_reduce_dp_sum(vel_gas(2))
    vel_gas(3)       = block_reduce_dp_sum(vel_gas(3))
    cs_gas           = block_reduce_dp_sum(cs_gas)
    m_gas            = block_reduce_dp_sum(m_gas)
    rho_av_all       = block_reduce_dp_sum(rho_av_all)
    weighted_bondi   = block_reduce_dp_sum(weighted_bondi)
    total_divergence = block_reduce_dp_sum(total_divergence)

    !-------------------------------------------
    ! Rate: compute and limit the accretion rate
    !-------------------------------------------
    if (j == 0) then
       dMBH = 0.0_dp
       rho_inf = 0.0_dp
       if (accretion_type == 1) then
          if (use_local_bondi_rate) then
             dMBH = weighted_bondi
          else
             v_rel(1:3) = vel_gas(1:3) - vp(1:3)
             if (bondi_use_vrel) then
                v_bondi = sqrt(v_rel(1)**2 + v_rel(2)**2 + v_rel(3)**2 + cs_gas**2)
             else
                v_bondi = cs_gas
             endif
             if (bondi_use_gas_mass) then
                bondi_mass = mp + m_gas
             else
                bondi_mass = mp
             endif
             rb = min(factG * bondi_mass / v_bondi**2, rb_max)
             if (use_rho_inf) then
                rho_inf = rho_gas / bondi_alpha_device(real(order, kind=dp) * 0.5_dp * dx_loc / (rb + tiny(1.0_dp)))
             else
                rho_inf = rho_gas
             endif
             dMBH = 4.0_dp * pi * rho_inf * rb * rb * v_bondi * lambda_sonic
          endif
       else if (accretion_type == 2) then
          dMBH = -total_divergence * vol_loc
          if (sink_density_threshold > 0.0_dp) then
             dMBH = dMBH * (1.0_dp + 0.1_dp * log(rho_gas / sink_density_threshold))
          endif
       else if (accretion_type == 3) then
          dMBH = 0.5_dp * (rho_gas - sink_density_threshold) * vol_loc * real(nBHnei, kind=dp)
       endif

       ! Eddington rate and optional cap
       dMED = edd_fac * mp
       if (eddington_cap > 0.0_dp) dMBH = min(dMBH, dMED * eddington_cap)

       ! If the accretion rate is too low, do nothing
       s_skip = (eddington_floor > 0.0_dp .and. dMBH / dMED < eddington_floor)

       if (.not. s_skip) then
          ! Limit total accreted mass to 75% of the accretion region mass
          dMBH = min(dMBH, 0.75_dp * rho_gas * vol_loc * real(nBHnei, kind=dp) / dtnew)
          if ((t - sink_tp(ipart)) < t_start_black_hole .and. t_start_black_hole > 0.0_dp) then
             dMBH = exp(t - sink_tp(ipart) - t_start_black_hole) * dMBH
          endif
          if (manual_accretion_rate > 0.0_dp) dMBH = manual_accretion_rate * dMED
       endif

       s_dMBH = dMBH
       s_rho_gas = rho_gas
    endif
    call syncthreads()

    ! The Eddington floor only skips the accretion itself: friction and
    ! AGN feedback still run with the capped rate (CPU early return)
    if (.not. s_skip) then

    !-------------------------------------------
    ! Scatter: accrete from local cells
    !-------------------------------------------
    m_acc = 0.0_dp; x_acc = 0.0_dp; p_acc = 0.0_dp; l_acc = 0.0_dp
    if (found) then
       if (.not. grid(igrid)%refined(icell)) then
          d     = max(uold(icell, 1, igrid), smallr)
          vv(1) = uold(icell, 2, igrid) / d
          vv(2) = uold(icell, 3, igrid) / d
          vv(3) = uold(icell, 4, igrid) / d
          e     = uold(icell, 5, igrid) / d
#ifdef MHD
          e = e - 0.5_dp * (bx**2 + by**2 + bz**2) / d
#endif
#if NENER>0
          do irad = 1, nener
             e = e - uold(icell, 5 + irad, igrid) / d
          end do
#endif
          ! Accreted density for this cell, never more than 75% of the cell
          d_acc = s_dMBH * dtnew * w / vol_loc
          if (mass_weighting) d_acc = d_acc * d / s_rho_gas
          d_acc = max(d_acc, 0.0_dp)
          d_acc = min(d_acc, 0.75_dp * d)

          ! Accrete from the cell
          info = atomicadd(unew(icell, 1, igrid), -d_acc)
          info = atomicadd(unew(icell, 2, igrid), -d_acc * vv(1))
          info = atomicadd(unew(icell, 3, igrid), -d_acc * vv(2))
          info = atomicadd(unew(icell, 4, igrid), -d_acc * vv(3))
          info = atomicadd(unew(icell, 5, igrid), -d_acc * e)
#if NVAR>5+NENER
          do ivar = 6 + nener, nvar
             info = atomicadd(unew(icell, ivar, igrid), -d_acc * uold(icell, ivar, igrid) / d)
          end do
#endif
          ! Accreted mass, relative center of mass, momentum and angular momentum
          v_rel(1:3) = vv(1:3) - vp(1:3)
          m_acc = d_acc * vol_loc
          if (momentum_conserving) then
             x_acc(1:3) = d_acc * x_rel(1:3) * vol_loc * dx_loc
             p_acc(1:3) = d_acc * v_rel(1:3) * vol_loc
             l_acc(1) = d_acc * (x_rel(2) * v_rel(3) - x_rel(3) * v_rel(2)) * vol_loc * dx_loc
             l_acc(2) = d_acc * (x_rel(3) * v_rel(1) - x_rel(1) * v_rel(3)) * vol_loc * dx_loc
             l_acc(3) = d_acc * (x_rel(1) * v_rel(2) - x_rel(2) * v_rel(1)) * vol_loc * dx_loc
          endif
       endif
    endif

    m_acc    = block_reduce_dp_sum(m_acc)
    x_acc(1) = block_reduce_dp_sum(x_acc(1))
    x_acc(2) = block_reduce_dp_sum(x_acc(2))
    x_acc(3) = block_reduce_dp_sum(x_acc(3))
    p_acc(1) = block_reduce_dp_sum(p_acc(1))
    p_acc(2) = block_reduce_dp_sum(p_acc(2))
    p_acc(3) = block_reduce_dp_sum(p_acc(3))
    l_acc(1) = block_reduce_dp_sum(l_acc(1))
    l_acc(2) = block_reduce_dp_sum(l_acc(2))
    l_acc(3) = block_reduce_dp_sum(l_acc(3))

    !-------------------------------------------
    ! Add accreted quantities to the sink
    !-------------------------------------------
    if (j == 0) then
       mtot = mp + m_acc
       if (.not. static) then
          sink_xp(ipart, 1) = sink_xp(ipart, 1) + x_acc(1) / mtot
          sink_xp(ipart, 2) = sink_xp(ipart, 2) + x_acc(2) / mtot
          sink_xp(ipart, 3) = sink_xp(ipart, 3) + x_acc(3) / mtot
       endif
       sink_vp(ipart, 1) = sink_vp(ipart, 1) + p_acc(1) / mtot
       sink_vp(ipart, 2) = sink_vp(ipart, 2) + p_acc(2) / mtot
       sink_vp(ipart, 3) = sink_vp(ipart, 3) + p_acc(3) / mtot
       sink_jp(ipart, 1) = (mp * sink_jp(ipart, 1) + l_acc(1)) / mtot
       sink_jp(ipart, 2) = (mp * sink_jp(ipart, 2) + l_acc(2)) / mtot
       sink_jp(ipart, 3) = (mp * sink_jp(ipart, 3) + l_acc(3)) / mtot
       if (.not. fix_sink_mass) sink_mp(ipart) = mtot
       info = atomicadd(macc_loc_d, m_acc)
    endif

    endif ! not s_skip
    endif ! accretion_type > 0

    !===========================================
    ! [D] Periodic box
    !===========================================
    if (j == 0) then
       if (periodic_d(1)) then
          if (sink_xp(ipart, 1) <  0.0_dp) sink_xp(ipart, 1) = sink_xp(ipart, 1) + bs1
          if (sink_xp(ipart, 1) >= bs1   ) sink_xp(ipart, 1) = sink_xp(ipart, 1) - bs1
       endif
       if (periodic_d(2)) then
          if (sink_xp(ipart, 2) <  0.0_dp) sink_xp(ipart, 2) = sink_xp(ipart, 2) + bs2
          if (sink_xp(ipart, 2) >= bs2   ) sink_xp(ipart, 2) = sink_xp(ipart, 2) - bs2
       endif
       if (periodic_d(3)) then
          if (sink_xp(ipart, 3) <  0.0_dp) sink_xp(ipart, 3) = sink_xp(ipart, 3) + bs3
          if (sink_xp(ipart, 3) >= bs3   ) sink_xp(ipart, 3) = sink_xp(ipart, 3) - bs3
       endif
    endif
  end subroutine sink_evolution_kernel

  ! =========================================================================
  ! Host Driver: sink accretion, friction, AGN feedback and periodic wrap
  ! for all sinks of level ilevel. Mirrors sink_evolution in sink_evolution.f90.
  ! =========================================================================
  subroutine gpu_sink_evolution(sim, ilevel, macc_loc)
    use nvtx
    use constants, only: pi, twopi, factG_in_cgs, mH, sigma_T, c_cgs
    use ramses_commons, only: ramses_t
    use gpu_runner, only: hash_key, hash_val, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: ilevel
    real(kind=8), intent(out) :: macc_loc

    real(kind=8) :: scale_nH, scale_T2, scale_l, scale_d, scale_t, scale_v
    real(kind=8) :: factG, lambda_sonic, edd_fac, dx_loc, vol_loc
    real(kind=dp), device :: macc_loc_d
    integer :: head_idx, nsink_lev, nBHnei

    associate(r=>sim%r, g=>sim%g, m=>sim%m, p=>sim%sink)

    macc_loc = 0.0d0
    head_idx = p%headp(ilevel)
    nsink_lev = p%tailp(ilevel) - head_idx + 1
    if (nsink_lev <= 0) return

    if (g%myid == 1 .and. r%verbose) write(*,*) 'Entering gpu_sink_evolution...'

    ! Conversion factor from user units to cgs units
    call units(r, g, scale_l, scale_t, scale_d, scale_v, scale_nH, scale_T2)

    ! Gravitational constant
    factG = 1d0
    if (r%cosmo) factG = 3d0/4d0/twopi*g%omega_m*g%aexp

    ! Bondi sonic constant
    if (r%use_bondi_lambda) then
       if (abs(r%gamma - 1).le.0.01) then
          lambda_sonic = 0.25d0*exp(1.5d0)
       else if (abs(r%gamma - 5.0d0/3.0d0).le.0.01) then
          lambda_sonic = 0.25d0
       else
          lambda_sonic = 0.5d0**((r%gamma + 1)/(2d0*(r%gamma - 1))) &
               & * (0.25d0*(5d0-3d0*r%gamma))**(-(5d0-3d0*r%gamma)/(2d0*(r%gamma - 1)))
       end if
    else
       lambda_sonic = 1.0d0
    end if

    ! Eddington rate per unit sink mass (code units)
    edd_fac = 4.0d0 * pi * factG_in_cgs * mH / (0.1d0 * sigma_T * c_cgs) * scale_t

    ! Mesh spacing in that level
    dx_loc = r%boxlen/2**ilevel
    vol_loc = dx_loc**ndim

    ! Number of cells within the B-spline region
    nBHnei = r%sink_b_spline_order**ndim

    macc_loc_d = 0.0_dp

    call nvtxStartRange("GPU Sink Evolution Kernel", color=5)!red
    call sink_evolution_kernel<<<nsink_lev, 256>>>( &
         & hash_key, hash_val, m%hash_size, ckey_max, key_off, m%ngridmax, &
         & box_ckey_min, box_ckey_max, periodic, &
         & head_idx, ilevel, r%sink_b_spline_order, nBHnei, r%accretion_type, &
         & real(m%skip(1),kind=dp), real(m%skip(2),kind=dp), real(m%skip(3),kind=dp), &
         & real(dx_loc,kind=dp), real(vol_loc,kind=dp), real(g%dtnew(ilevel),kind=dp), real(g%t,kind=dp), &
         & real(factG,kind=dp), real(lambda_sonic,kind=dp), real(edd_fac,kind=dp), &
         & real(r%eddington_cap,kind=dp), real(r%eddington_floor,kind=dp), &
         & real(r%t_start_black_hole,kind=dp), real(r%manual_accretion_rate,kind=dp), &
         & real(r%sink_density_threshold,kind=dp), &
         & real(r%gamma,kind=dp), real(r%smallr,kind=dp), real(r%smallc,kind=dp), &
         & real(r%acc_sink_boost**(-2d0/3d0),kind=dp), &
         & r%use_local_bondi_rate, r%bondi_use_vrel, r%bondi_use_gas_mass, r%use_rho_inf, &
         & r%mass_weighting, r%momentum_conserving, r%fix_sink_mass, p%static, &
         & real(r%box_size(1),kind=dp), real(r%box_size(2),kind=dp), real(r%box_size(3),kind=dp), &
         & macc_loc_d)
    call GPU_Error_Check(__FILE__, __LINE__)
    call nvtxEndRange()

    ! Copy back the total accreted mass from device to host
    macc_loc = real(macc_loc_d, kind=8)

    end associate
  end subroutine gpu_sink_evolution

end module sink_device
